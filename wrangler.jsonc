{
  "name": "fc26-build-lab-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-13",
  "vars": {
    "ALLOWED_ORIGINS": "https://ljp46.github.io",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "AI_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-5.4-mini"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
